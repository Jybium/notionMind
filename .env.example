# ── NotionMind v2 — OAuth & Persistence Configuration ──

# Server
PORT=3000

# Database (SQLite)
DATABASE_URL="file:./dev.db"

# Google OAuth (Gmail & Calendar)
# Generate at console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Notion OAuth
# Generate at notion.so/my-integrations (Public Integration)
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret
NOTION_REDIRECT_URI=http://localhost:3000/api/auth/notion/callback

# MCP Server Defaults
GMAIL_MCP_URL=https://gmail.mcp.claude.com/mcp
GCAL_MCP_URL=https://gcal.mcp.claude.com/mcp
